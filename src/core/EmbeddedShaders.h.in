#pragma once

/**
 * @file EmbeddedShaders.h
 * @brief Auto-generated by CMake from the .glsl files under @c shaders/.
 *
 * Each shader source is embedded as a raw-string literal so the executable
 * does not need to ship loose .glsl files alongside it. The CMake configure
 * step re-runs whenever any source shader changes (CMAKE_CONFIGURE_DEPENDS).
 *
 * Do not edit this file by hand — edit the corresponding .glsl source and
 * reconfigure.
 */

namespace embedded_shaders {

inline constexpr const char* VertexShader = R"glsl(@VERTEX_SHADER_SOURCE@)glsl";
inline constexpr const char* FragmentShader = R"glsl(@FRAGMENT_SHADER_SOURCE@)glsl";

inline constexpr const char* GridVertexShader = R"glsl(@GRID_VERTEX_SHADER_SOURCE@)glsl";
inline constexpr const char* GridFragmentShader = R"glsl(@GRID_FRAGMENT_SHADER_SOURCE@)glsl";

inline constexpr const char* TrailVertexShader = R"glsl(@TRAIL_VERTEX_SHADER_SOURCE@)glsl";
inline constexpr const char* TrailFragmentShader = R"glsl(@TRAIL_FRAGMENT_SHADER_SOURCE@)glsl";

inline constexpr const char* SkyVertexShader = R"glsl(@SKY_VERTEX_SHADER_SOURCE@)glsl";
inline constexpr const char* SkyFragmentShader = R"glsl(@SKY_FRAGMENT_SHADER_SOURCE@)glsl";

inline constexpr const char* RingVertexShader = R"glsl(@RING_VERTEX_SHADER_SOURCE@)glsl";
inline constexpr const char* RingFragmentShader = R"glsl(@RING_FRAGMENT_SHADER_SOURCE@)glsl";

inline constexpr const char* AtmosphereVertexShader = R"glsl(@ATMOSPHERE_VERTEX_SHADER_SOURCE@)glsl";
inline constexpr const char* AtmosphereFragmentShader = R"glsl(@ATMOSPHERE_FRAGMENT_SHADER_SOURCE@)glsl";

inline constexpr const char* FullscreenQuadVertexShader = R"glsl(@FULLSCREEN_QUAD_VERTEX_SHADER_SOURCE@)glsl";
inline constexpr const char* BloomBlurFragmentShader = R"glsl(@BLOOM_BLUR_FRAGMENT_SHADER_SOURCE@)glsl";
inline constexpr const char* BloomCompositeFragmentShader = R"glsl(@BLOOM_COMPOSITE_FRAGMENT_SHADER_SOURCE@)glsl";

}  // namespace embedded_shaders
