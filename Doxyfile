# Doxygen configuration for SolarSystemGL.
# Only non-default options are set; everything else uses Doxygen defaults.
# Generate locally with:  doxygen Doxyfile   (output in build-docs/html)
# CI fetches doxygen-awesome-css into ./doxygen-awesome-css before running.

#---------------------------------------------------------------------------
# Project
#---------------------------------------------------------------------------
PROJECT_NAME           = "SolarSystemGL"
PROJECT_BRIEF          = "Newtonian N-body solar-system simulator — native OpenGL & WebGL/WebAssembly"
OUTPUT_DIRECTORY       = build-docs
CREATE_SUBDIRS         = NO
OPTIMIZE_OUTPUT_FOR_C  = NO
MARKDOWN_SUPPORT       = YES
USE_MDFILE_AS_MAINPAGE = README.md
TAB_SIZE               = 4

#---------------------------------------------------------------------------
# Input
#---------------------------------------------------------------------------
INPUT                  = src README.md
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.hpp *.cpp *.md
EXCLUDE_PATTERNS       = */third_party/* */build*/*
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES

#---------------------------------------------------------------------------
# Build / warnings
#---------------------------------------------------------------------------
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
QUIET                  = YES
WARNINGS               = YES

#---------------------------------------------------------------------------
# HTML output (doxygen-awesome-css theme)
#---------------------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
HTML_COLORSTYLE        = LIGHT
HTML_EXTRA_STYLESHEET  = doxygen-awesome-css/doxygen-awesome.css \
                         doxygen-awesome-css/doxygen-awesome-sidebar-only.css

#---------------------------------------------------------------------------
# Diagrams (graphviz)
#---------------------------------------------------------------------------
HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = NO
UML_LOOK               = YES
